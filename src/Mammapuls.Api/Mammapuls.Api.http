@Mammapuls.Api_HostAddress = http://localhost:5186
@Mammapuls.Api_HttpsAddress = https://localhost:7176

### Ping
GET {{Mammapuls.Api_HostAddress}}/api/v1/ping
Accept: application/json

### OpenAPI document (Development and Test only)
GET {{Mammapuls.Api_HostAddress}}/openapi/v1.json

### Scalar API reference (Development and Test only) — open in a browser; sign in first via
### {{Mammapuls.Api_HttpsAddress}}/api/v1/auth/login?returnUrl=/scalar/v1 so the session cookie is sent
GET {{Mammapuls.Api_HttpsAddress}}/scalar/v1

### Health (Development only)
GET {{Mammapuls.Api_HostAddress}}/health

### Login — open this URL in a browser (redirects to Vipps test, then back to returnUrl)
GET {{Mammapuls.Api_HttpsAddress}}/api/v1/auth/login?returnUrl=http://localhost:5173/

### Login with a disallowed returnUrl — expect 400
GET {{Mammapuls.Api_HttpsAddress}}/api/v1/auth/login?returnUrl=https://evil.example/

### Me — expect 401 without the session cookie
GET {{Mammapuls.Api_HttpsAddress}}/api/v1/me
Accept: application/json

### Logout — X-Requested-With is required on non-GET requests (CSRF defence)
POST {{Mammapuls.Api_HttpsAddress}}/api/v1/auth/logout
X-Requested-With: XMLHttpRequest

### Logout without the CSRF header — expect 400
POST {{Mammapuls.Api_HttpsAddress}}/api/v1/auth/logout

### Delete my account (GDPR) — requires session cookie
DELETE {{Mammapuls.Api_HttpsAddress}}/api/v1/me
X-Requested-With: XMLHttpRequest

### Save or replace my onboarding questionnaire — requires session cookie
PUT {{Mammapuls.Api_HttpsAddress}}/api/v1/me/onboarding
Content-Type: application/json
X-Requested-With: XMLHttpRequest

{
	"fullName": "Ada Lovelace",
	"age": 36,
	"sleepPerNight": "sevenToEightHours",
	"stressLevel": 4,
	"weightKg": 72.5,
	"heightCm": 168,
	"waistCm": 78,
	"chestCm": 92,
	"hipCm": 101,
	"canJogComfortably": true,
	"stepsPerDay": "from5000To10000",
	"trainingDaysPerWeek": "oneToTwo",
	"isVegetarian": false,
	"isPescetarian": false,
	"isBreastfeeding": false,
	"hasAllergies": false,
	"allergyDetails": null,
	"hasInjuries": false,
	"injuryDetails": null,
	"hasTriedWeightLossBefore": true,
	"previousWeightLossExperience": "I have tried to build a consistent routine.",
	"foodAndExerciseRelationship": "good",
	"hasHadEatingDisorder": false,
	"healthSatisfaction": 7,
	"programMotivation": 9,
	"goalAfterEightWeeks": "Build habits I can keep up.",
	"biggestChallenge": "Finding time for training.",
	"anythingElseForCoach": "Looking forward to getting started."
}

### Read my onboarding questionnaire — requires session cookie
GET {{Mammapuls.Api_HttpsAddress}}/api/v1/me/onboarding
Accept: application/json

###
